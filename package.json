{
  "name": "bookleaf-assessment-workspace",
  "version": "1.0.0",
  "description": "BookLeaf Publishing Full-Stack Technical Assessments (Assignment 1 & Assignment 2)",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "echo 'Run npm run dev:assignment_1 or npm run dev:assignment_2'",
    "test:all": "node scripts/setup.js && npm run test:assignment_2",
    "dev:assignment1": "cd assignment_1 && npm run dev",
    "dev:assignment_1": "cd assignment_1 && npm run dev",
    "dev:assignment-1": "cd assignment_1 && npm run dev",
    "dev:assignment2": "cd assignment_2/app && npm run dev",
    "dev:assignment_2": "cd assignment_2/app && npm run dev",
    "dev:assignment-2": "cd assignment_2/app && npm run dev",
    "test:assignment1": "cd assignment_1 && npm run test:ai",
    "test:assignment_1": "cd assignment_1 && npm run test:ai",
    "test:assignment-1": "cd assignment_1 && npm run test:ai",
    "test:assignment2": "cd assignment_2/app && npm test",
    "test:assignment_2": "cd assignment_2/app && npm test",
    "test:assignment-2": "cd assignment_2/app && npm test"
  }
}
